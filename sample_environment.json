    {
      "role_name": "etl-service-account",
      "permissions": [
        {"actions": ["storage:GetObject", "storage:PutObject"], "resources": ["storage/raw-landing-zone/*"]},
        {"actions": ["warehouse:Insert"], "resources": ["warehouse/analytics_dw/staging"]}
      ],
      "break_glass_admin_role": false
    }
  ],

  "resources": [
    {
      "name": "raw-landing-zone",
      "type": "Object Storage",
      "contains_sensitive_data": true,
      "data_classification": "Confidential (customer PII)",
      "encryption_at_rest": true,
      "key_type": "customer-managed",
      "encryption_in_transit": true,
      "public_access": false,
      "versioning_enabled": true
    },
    {
      "name": "marketing-exports",
      "type": "Object Storage",
      "contains_sensitive_data": true,
      "data_classification": "Confidential (customer emails)",
      "encryption_at_rest": false,
      "key_type": "none",
      "encryption_in_transit": true,
      "public_access": true,
      "versioning_enabled": false
    },
    {
      "name": "analytics_dw",
      "type": "Data Warehouse",
      "contains_sensitive_data": true,
      "data_classification": "Confidential (sales and customer data)",
      "encryption_at_rest": true,
      "key_type": "provider-managed",
      "encryption_in_transit": true
    },
    {
      "name": "daily-sales-etl",
      "type": "Data Pipeline",
      "contains_sensitive_data": true,
      "data_classification": "Confidential (moves customer data)",
      "encryption_at_rest": true,
      "key_type": "customer-managed",
      "encryption_in_transit": false
    },
    {
      "name": "public-reference-data",
      "type": "Object Storage",
      "contains_sensitive_data": false,
      "data_classification": "Public",
      "encryption_at_rest": true,
      "key_type": "provider-managed",
      "encryption_in_transit": true,
      "public_access": false,
      "versioning_enabled": true
    }
  ],

  "logging_monitoring": {
    "audit_logging_enabled": true,
    "logs_centralised": true,
    "log_retention_days": 90,
    "security_alerts_enabled": false
  },

  "key_management": {
    "key_rotation_enabled": true,
    "rotation_period_days": 365
  }
}
